# =============================================================================
# CONFIGURATION FEDAPAY - NOUVEL INTEGRATEUR DE PAIEMENT
# =============================================================================
# POUR TEST LOCAL: Utiliser 'sandbox' avec une clé de test (sk_test_...)
# POUR PRODUCTION: Utiliser 'live' avec une clé live (sk_live_...)

# Environnement: 'sandbox' pour test, 'live' pour production
FEDAPAY_ENVIRONMENT=sandbox

# Clé API secrète FedaPay (à obtenir depuis le tableau de bord FedaPay)
FEDAPAY_SECRET_KEY=sk_test_votre_cle_test_ici

# Secret webhook pour vérifier les signatures (optionnel mais recommandé)
FEDAPAY_WEBHOOK_SECRET=wh_test_votre_secret_webhook_ici

# Clés live (à utiliser uniquement en production)
# FEDAPAY_PUBLIC_KEY=pk_live_...
# FEDAPAY_WEBHOOK_SECRET=wh_live_...

